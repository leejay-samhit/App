{
  "expo": {
    "name": "Slangcart",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#143D2E",
    "androidStatusBar": {
      "backgroundColor": "#143D2E",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#143D2E",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan product barcodes and capture KYC selfies",
        "NSPhotoLibraryUsageDescription": "Upload KYC documents from your photos",
        "NSLocationWhenInUseUsageDescription": "Show nearby providers and accurate delivery estimates.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Keep your map pin fresh so customers nearby can find you.",
        "NSLocationAlwaysUsageDescription": "Keep your map pin fresh so customers nearby can find you.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSFaceIDUsageDescription": "Sign in instantly with Face ID instead of typing your password.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSPinnedDomains": {
            "REPLACE_WITH_PROD_API_HOSTNAME": {
              "NSIncludesSubdomains": true,
              "NSPinnedCAIdentities": [
                {
                  "SPKI-SHA256-BASE64": "REPLACE_WITH_PRIMARY_PIN_SHA256_BASE64"
                },
                {
                  "SPKI-SHA256-BASE64": "REPLACE_WITH_BACKUP_PIN_SHA256_BASE64"
                }
              ]
            }
          }
        }
      },
      "bundleIdentifier": "app.emergent.networkpay16728573e"
    },
    "android": {
      "package": "com.slangcart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#143D2E"
      },
      "edgeToEdgeEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 1920,
          "resizeMode": "cover",
          "backgroundColor": "#143D2E",
          "android": {
            "backgroundColor": "#143D2E",
            "image": "./assets/images/splash-image.png",
            "imageWidth": 1920,
            "resizeMode": "cover"
          },
          "ios": {
            "backgroundColor": "#143D2E",
            "image": "./assets/images/splash-image.png",
            "resizeMode": "cover"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.facebook.fbreact.specs.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class expo.modules.** { *; }\n-keep class versioned.host.exp.exponent.modules.** { *; }",
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#143D2E",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Keep your map pin fresh so customers nearby can find you.",
          "locationAlwaysPermission": "Keep your map pin fresh so customers nearby can find you.",
          "locationWhenInUsePermission": "Show nearby providers and accurate delivery estimates.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
